  node --test --test-concurrency=2 test/custom-types.test.ts test/entry-from.test.ts test/extension.test.ts,project,codex-agent,"2026-11-24T19:11:31.861Z",local_mutation,deps/adopt-pm-cli-host-alignment-1122
