  "npm run release:check",project,codex-sol,"2026-10-07T12:56:03.593Z",local_mutation,feat/refuse-partial-envelopes
  "bun run release:check",project,codex-sol,"2026-10-07T12:56:03.593Z",local_mutation,feat/refuse-partial-envelopes
