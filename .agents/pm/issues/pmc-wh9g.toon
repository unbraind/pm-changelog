  test/generator.test.ts,project
  test/published-section-stability.test.ts,project
tests[1]{command,scope,timeout_seconds,provenance{author,created_at,source_kind,source_ref}}:
  node --test --test-concurrency=2 test/generator.test.ts test/published-section-stability.test.ts,project,600,codex-sol,"2026-11-17T22:16:42.597Z",local_mutation,fix/check-ignores-unreachable-releases
docs[1]{path,scope}:
  docs/stable-check-evidence.md,project
body: "Root cause is in release-tag window discovery. The CLI sets includeOrphaned, which omits git tag --merged HEAD. That correctly keeps rebase-orphaned tags, but it also admits descendant tags. The newest descendant becomes the leading window and claims work closed after the previous reachable tag."
