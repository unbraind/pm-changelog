  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern \"drops a pending window but keeps tagged windows, and is a no-op once the version is tagged\" test/release-context.test.ts",test/release-context.test.ts,project,"drops a pending window but keeps tagged windows, and is a no-op once the version is tagged"
  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern \"returns no windows when suppression coincides with includeUnreleased false\" test/release-context.test.ts",test/release-context.test.ts,project,returns no windows when suppression coincides with includeUnreleased false
  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern=\"--no-pending-release keeps a never-released package version out of the headings\" test/generator.test.ts",test/generator.test.ts,project,"--no-pending-release keeps a never-released package version out of the headings"
  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern \"an explicitly empty suppressed window list renders no release heading through createChangelog\" test/generator.test.ts",test/generator.test.ts,project,"an explicitly empty suppressed window list renders no release heading through createChangelog (finding 1: empty vs absent window list distinction, tested through createChangelog)"
  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern \"--all-release-tags with zero tags and no version keeps the Unreleased fallback\" test/generator.test.ts",test/generator.test.ts,project,"--all-release-tags with zero tags and no version keeps the Unreleased fallback (CLI spells empty resolution as absent so the single-version fallback renders the work, not a title-only changelog)"
  "PM_PATH=/tmp/pmc-1vma PM_GLOBAL_PATH=/tmp/pmc-1vma-g node --test --test-name-pattern \"explainChangelogSelection counts a suppressed-release declaration as release-pinned\" test/generator.test.ts",test/generator.test.ts,project,"explainChangelogSelection counts a suppressed-release declaration as release-pinned (provenance agrees with placement: suppressed declaration is a release pin, not a timestamp attribution)"
close_reason: "Added and proved the --no-pending-release control: never-released package versions no longer claim a release heading, default and release-run behaviour unchanged, 100/100/100 coverage held, and every new test revert-proofed red."
