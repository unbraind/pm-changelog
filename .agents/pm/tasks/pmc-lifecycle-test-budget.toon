      created_at: "2026-11-15T09:47:01.974Z"
      source_kind: local_mutation
      source_ref: ci/quick-pr-tier-deep-local-tier
  - command: env PM_TEST_DEPTH=quick PM_TEST_TIME_SCALE=3 node --test --test-concurrency=2 test/acceptance-process.test.ts test/depth.test.ts test/agent-contract-drift.test.ts test/closure-status-roles.test.ts test/consumer-upgrades.test.ts test/contract-projections.test.ts test/contract-report-closure.test.ts test/generator-redos.test.ts test/generator.test.ts test/item-links.test.ts test/pending-version.test.ts test/proof-baseline.test.ts test/release-context.test.ts test/release-corrections.test.ts test/release-lifecycles.test.ts test/release-ownership.test.ts test/release-publication.test.ts test/stable-itemless-check.test.ts test/unicode-contract-output.test.ts
    scope: project
    timeout_seconds: 1200
