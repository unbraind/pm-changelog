{"hash_algorithm":"sha256","ts":"2026-11-17T18:28:24.638Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"grok-4.7","agent_model_source":"environment","agent_instance":"112d48127ede778beff721ba","agent_provenance":{"model":{"value":"grok-4.7","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"replace","path":"/body","value":"Root cause is in release-tag window discovery. The CLI sets includeOrphaned, which omits git tag --merged HEAD. That correctly keeps rebase-orphaned tags, but it also admits descendant tags. The newest descendant becomes the leading window and claims work closed after the previous reachable tag."},{"op":"add","path":"/metadata/id","value":"pmc-wh9g"},{"op":"add","path":"/metadata/title","value":"Descendant release tags must not retitle an older checkout"},{"op":"add","path":"/metadata/description","value":"A release tag that contains HEAD but is not merged into HEAD is a later publication, not an orphaned tag. --all-release-tags still lists it because includeOrphaned drops the merged-HEAD filter, so changelog:check at an older commit rewrites the committed heading to that later release after the tag is published."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["changelog","ci"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-17T18:28:24.638Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-17T18:28:24.638Z"},{"op":"add","path":"/metadata/author","value":"pi-glm"},{"op":"add","path":"/metadata/repro_steps","value":"Check out a commit that predates a published release tag, fetch tags, and run changelog:check with --all-release-tags."},{"op":"add","path":"/metadata/expected_result","value":"A release whose tag is not reachable from HEAD never changes that checkout. --check at the older commit stays stable after the later release is published. Rebase-orphaned tags still remain available."},{"op":"add","path":"/metadata/actual_result","value":"Scheduled CI Deep at a pre-release commit failed changelog:check as tracker_changed, replacing the committed heading with the later release heading once that tag existed."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"1ca3432947e8994fce52487c3f09034fa4e1a74732643ab9447d72c3e3a30fd0","item_hash_version":3,"message":"Record the unreachable descendant release heading defect","event_class":"substantive","record_hash_version":1,"record_hash":"944f93942666e721a8d1a2ab0d39629dd2c8394c8387d2708cd99921bd7d26db"}
