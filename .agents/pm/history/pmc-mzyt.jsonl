{"hash_algorithm":"sha256","ts":"2026-11-16T22:33:30.642Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"da2feb3dffed02a6a88aecaf","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/3","value":{"created_at":"2026-11-16T22:33:30.640Z","author":"pi-glm","text":"Delivered as https://github.com/unbraind/pm-changelog/pull/362 (Fixes #349) on branch fix/published-section-stability, head 5043ad6. Gates at push: tsc --noEmit, docstring gate, node --test test/published-section-stability.test.ts (5 pass), the generator/release/check/cli regression suites (403 tests pass), and changelog:check all green. Item paused to open for orchestrator verification; not closed."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-16T22:33:30.642Z"}],"before_hash":"faa1ad60d51e97b5247cb382adcda274c0f6b814968a69b07f1b088b3676db65","after_hash":"5890269b12663aa05351cd63a0c67c59c8424bc99b780bbcf2916885cfcf1136","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"a04e5be7730dfce6f7ee4a7b1649c6ed9f1c93e147497272d898568b1f47bfd1"}
