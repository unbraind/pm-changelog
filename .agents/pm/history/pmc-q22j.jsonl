{"ts":"2026-08-24T09:42:16.204Z","author":"harness:claude-code","author_source":"asserted","agent_harness":"claude-code","agent_instance":"365e646596cb83e6152b34c6","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"replace","path":"/body","value":"The release workflow tags only after npm publish succeeds. Publish has failed fleet wide since 2026-08-21, so this package carries an untagged version and sits on the clock dependent path its own flag exists to remove."},{"op":"add","path":"/metadata/id","value":"pmc-q22j"},{"op":"add","path":"/metadata/title","value":"This package generates its own changelog without the flag that stops the heading date coming from the clock"},{"op":"add","path":"/metadata/description","value":"pm-changelog synthesises a pending release window for a version with no matching git tag and stamps it with the current UTC date. Its own changelog scripts and release workflow did not pass the date-from-version flag, the one this package itself ships for exactly that case, so its changelog check regenerates a different heading date every day and fails on any day after the changelog was written. Applied the flag to every invocation of the generator here: two sites in package.json and one in the release workflow."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["changelog","gates","release"]},{"op":"add","path":"/metadata/created_at","value":"2026-08-24T09:42:16.204Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-24T09:42:16.204Z"},{"op":"add","path":"/metadata/deadline","value":"2026-08-31T00:00:00.000Z"},{"op":"add","path":"/metadata/assignee","value":"harness:claude-code"},{"op":"add","path":"/metadata/author","value":"harness:claude-code"},{"op":"add","path":"/metadata/estimated_minutes","value":30},{"op":"add","path":"/metadata/acceptance_criteria","value":"Every invocation of the generator in this package passes the flag, and changelog check passes on a day other than the version's own calendar date"},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pmc-ilrh","kind":"related","created_at":"2026-08-24T09:42:16.204Z","author":"harness:claude-code","source_kind":"cli:create:dep","author_source":"detected"}]},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-24T09:42:16.204Z","author":"harness:claude-code","text":"Found while rolling this fix across the fleet; this package was exposed to the defect it fixes for everyone else."}]},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-08-24T09:42:16.204Z","author":"harness:claude-code","text":"Site audit after the change: package.json 2 of 2 flagged, release.yml 1 of 1 flagged."}]},{"op":"add","path":"/metadata/learnings","value":[{"created_at":"2026-08-24T09:42:16.204Z","author":"harness:claude-code","text":"A package that ships a remedy is not automatically a package that applies it; the rollout has to include the origin repo."}]},{"op":"add","path":"/metadata/files","value":[{"path":"package.json","scope":"project"}]},{"op":"add","path":"/metadata/tests","value":[{"command":"npm run changelog:check","scope":"project"}]},{"op":"add","path":"/metadata/docs","value":[{"path":"https://github.com/unbraind/pm-changelog/blob/main/README.md","scope":"project","note":"flag reference"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"57a11f33f2cb0629017e7c2f794883e1eace7d42d02a1886738bc913bbe6b9ef","item_hash_version":2,"message":"Apply the version-derived release date to pm-changelog's own generator invocations","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"}}}}
