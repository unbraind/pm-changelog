fidence","value":"high"},{"op":"add","path":"/metadata/severity","value":"high"},{"op":"add","path":"/metadata/environment","value":"Node 22.23.1 coverage gate with test files scheduled across workers"},{"op":"add","path":"/metadata/repro_steps","value":"Run npm run coverage repeatedly under Node 22.23.1 and inspect src/generator.ts lines in the installed pm resolution branch."},{"op":"add","path":"/metadata/expected_result","value":"Every identical run directly covers all installed pm resolution guards and reports deterministic 100 percent line branch and function coverage."},{"op":"add","path":"/metadata/actual_result","value":"Identical SHA reruns can report either generator.ts uncovered resolution errors or exact coverage because entry into memoized resolution depends on test scheduling."},{"op":"add","path":"/metadata/component","value":"src/generator.ts installed pm command resolution"},{"op":"add","path":"/metadata/customer_impact","value":"A mandatory gate can reject unchanged input nondeterministically and obscure genuinely untested error handling."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"b2bc2b439a770d3ed15a09892c9f98d550e6310ea605c0ec2e9e5185a59c4b7f","item_hash_version":3,"message":"Track deterministic installed pm resolution coverage"}
