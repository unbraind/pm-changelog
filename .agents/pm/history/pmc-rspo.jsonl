{"hash_algorithm":"sha256","ts":"2026-10-14T14:26:23.060Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"0491afdc76d1fa802b8a2b19","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.299","source":"probe"}},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/6","value":{"created_at":"2026-10-14T14:26:23.060Z","author":"claude-hub","text":"CodeQL alert 9 (js/polynomial-redos, src/item-links.ts:30) on PR #241: the link-check regex /\\]\\(([^)\\s]+)\\)/g backtracks quadratically on repeated '](!' (measured 161 ms at 5k, 669 ms at 10k, 2748 ms at 20k repetitions). Replaced by markdownLinkTargets(), a single-pass scanner that resumes at the stop character after a failed scan. Test 'link targets match the former regex exactly and stay linear on hostile markdown' checks equivalence against the old regex on 11 edge samples (empty, spaced, nested '](', NBSP, newline, unclosed) and scans 200k repetitions in under 1 s (47 ms). With the old regex restored, that input takes minutes and the bound fails."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-10-14T14:26:23.060Z"}],"before_hash":"b8c65e094a9a6a50230324b6d9f6076c31baadbe432af0dc14785928bded5eda","after_hash":"1c30560122d785336eaa0f8c7c25ecb70df4237e53a27a8cc9edd2c1b122ade6","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"698b8000877d6bd67fe72ab77a8231fba606caa54b2e5efb15bc3f519fbbf576"}
